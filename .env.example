# FAZIX Production Domain
NEXT_PUBLIC_SITE_URL=https://fazix-esport.xyz

# Secret key for Discord Bot API authentication (must match bot's FAZIX_DISCORD_BOT_SECRET)
FAZIX_DISCORD_BOT_SECRET=fazix_dev_discord_bot_secret_2026

# ApiVerve Reading Time API Key (https://apiverve.com/marketplace/api/readingtime)
APIVERVE_API_KEY=your_apiverve_api_key_here

# Contact Form & Roster Application Forwarding Target
CONTACT_EMAIL_TARGET=fazixesports@gmail.com

# OPTION 1: Web3Forms (RECOMMENDED - 100% free, 250 emails/mo, zero SMTP hassle)
# Simply enter fazixesports@gmail.com at https://web3forms.com to receive your free access key
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# OPTION 2: Resend (https://resend.com - 3,000 free emails/mo)
# RESEND_API_KEY=re_your_resend_api_key

# OPTION 3: Brevo Free SMTP (https://brevo.com - 300 free emails/day)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_brevo_account_email
# SMTP_PASS=your_brevo_smtp_key

# OPTION 4: Discord Staff Channel Webhook (optional, receives notifications in Discord)
# DISCORD_CONTACT_WEBHOOK_URL=https://discord.com/api/webhooks/...
